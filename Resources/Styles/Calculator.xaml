<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette -->
    <Color x:Key="PageBackground">#0F1115</Color>
    <Color x:Key="CardBackground">#1A1D24</Color>
    <Color x:Key="CardStroke">#2A2F3A</Color>
    <Color x:Key="TextPrimary">#F5F7FA</Color>
    <Color x:Key="TextSecondary">#8A93A6</Color>
    <Color x:Key="ErrorText">#FF6B6B</Color>
    <Color x:Key="DigitKeyColor">#252A33</Color>
    <Color x:Key="FunctionKeyColor">#353B47</Color>
    <Color x:Key="OperatorKeyColor">#FF9F0A</Color>
    <Color x:Key="ClearKeyColor">#E5484D</Color>
    <Color x:Key="EqualsKeyColor">#30A46C</Color>

    <Style x:Key="DisplayCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="18,12" />
    </Style>

    <!-- Style de base des touches : aucune taille minimale imposée pour que
         le clavier se contracte sur les petits écrans au lieu de déborder. -->
    <Style x:Key="KeyBase" TargetType="Button">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Disabled" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="DigitKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource DigitKeyColor}" />
    </Style>

    <Style x:Key="FunctionKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource FunctionKeyColor}" />
    </Style>

    <!-- Touches de la FlexLayout : largeur calée en code-behind sur celle d'une colonne du clavier,
         JustifyContent="SpaceBetween" répartit l'espace restant entre elles. -->
    <Style x:Key="FlexFunctionKey" TargetType="Button" BasedOn="{StaticResource FunctionKey}">
        <Setter Property="FlexLayout.Shrink" Value="0" />
    </Style>

    <Style x:Key="OperatorKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource OperatorKeyColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ClearKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource ClearKeyColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="EqualsKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource EqualsKeyColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource OperatorKeyColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
</ResourceDictionary>
